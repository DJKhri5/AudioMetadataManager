{
  "BackupSettings": {
    "RootFolderName": "AudioMetadataManager_Backup",
    "RetentionDays": 30,
    "MaxTotalSizeMB": 1024
  },
  "ScanSettings": {
    "SupportedExtensions": [".mp3", ".flac", ".wav", ".aac", ".m4a", ".ogg", ".wma", ".opus", ".ape", ".aiff"],
    "MaxDepth": 5,
    "ExcludeFolders": ["$Recycle.Bin", "System Volume Information", "Temp", "TMP"]
  },
  "NamingSettings": {
    "DefaultTemplate": "{artist} - {title} ({version}){extension}",
    "UsePartialDataWhenMissing": true,
    "RemoveLeadingTrackNumbers": true,
    "RemoveSiteTags": true,
    "RemoveEncoderTags": true
  },
  "Application": {
    "Version": "0.4.0",
    "LogLevel": "Info"
  }
}