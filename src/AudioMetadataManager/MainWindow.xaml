<Window x:Class="AudioMetadataManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Audio Metadata Manager 0.2" Height="780" Width="1320" MinHeight="650" MinWidth="1000">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,0,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Audio Metadata Manager" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="v0.2 · Modo Simulación · Ningún audio será modificado" Foreground="#D1D5DB"/></StackPanel>
        <TextBlock Grid.Column="1" Text="SIMULACIÓN" Foreground="#FDE68A" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Abrir carpeta" Click="OpenFolder_Click"/><Button Content="Guardar proyecto" Click="SaveProject_Click"/><Button Content="Abrir proyecto" Click="OpenProject_Click"/><Button Content="Exportar CSV" Click="ExportCsv_Click"/><Button Content="Crear respaldo" Click="Backup_Click"/><Button Content="Cancelar" Click="Cancel_Click"/>
    </StackPanel>
    <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock x:Name="StatusText" Text="Listo"/></StatusBarItem><Separator/><StatusBarItem><ProgressBar x:Name="Progress" Width="220" Height="16" Minimum="0" Maximum="100"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="CountText"/></StatusBarItem></StatusBar>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ItemsGrid_SelectionChanged" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="34" IsReadOnly="False"/>
          <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*"/>
          <DataGridTextColumn Header="Propuesto" Binding="{Binding ProposedFileName}" Width="2*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="150"/>
          <DataGridTextColumn Header="Formato" Binding="{Binding Extension}" Width="70"/>
          <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="90"/>
          <DataGridTextColumn Header="Duplicado" Binding="{Binding DuplicateGroup}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"/>
      <ScrollViewer Grid.Column="2"><StackPanel Margin="10,0,0,0">
        <TextBlock Text="Detalle del archivo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="Ruta" FontWeight="Bold"/><TextBox x:Name="PathBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,8"/>
        <TextBlock Text="Nombre propuesto" FontWeight="Bold"/><TextBox x:Name="ProposedBox" IsReadOnly="True" Margin="0,2,0,8"/>
        <UniformGrid Columns="2" Margin="0,0,0,8"><StackPanel Margin="0,0,6,0"><TextBlock Text="Artista" FontWeight="Bold"/><TextBox x:Name="ArtistBox" IsReadOnly="True"/></StackPanel><StackPanel><TextBlock Text="Título" FontWeight="Bold"/><TextBox x:Name="TitleBox" IsReadOnly="True"/></StackPanel></UniformGrid>
        <TextBlock Text="Versión / Mix" FontWeight="Bold"/><TextBox x:Name="VersionBox" IsReadOnly="True" Margin="0,2,0,8"/>
        <TextBlock Text="Características técnicas" FontWeight="Bold"/><TextBox x:Name="TechnicalBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,8"/>
        <TextBlock Text="Estado" FontWeight="Bold"/><TextBox x:Name="ItemStatusBox" IsReadOnly="True" Margin="0,2,0,8"/>
        <TextBlock Text="Advertencias" FontWeight="Bold"/><TextBox x:Name="WarningsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" Margin="0,2,0,8"/>
        <Border Background="#FEF3C7" Padding="10" CornerRadius="6"><TextBlock TextWrapping="Wrap" Text="La v0.2 analiza y respalda. No renombra, no mueve y no escribe etiquetas. La evaluación de bitrate MP3 falso se incorporará con análisis espectral en una versión posterior."/></Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
