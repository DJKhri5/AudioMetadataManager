<Window x:Class="AudioMetadataManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:AudioMetadataManager.UI.Views.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioMetadataManager.UI.Views"
        Title="Audio Metadata Manager"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nuevo proyecto"/>
                <MenuItem Header="Abrir proyecto"/>
                <Separator/>
                <MenuItem Header="Salir"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem
            Header="Fuentes de metadatos..."
            Click="OpenMetadataSourcesSettings_Click"/>

                <Separator/>

                <MenuItem Header="Configuración"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="Acerca de Audio Metadata Manager"/>
            </MenuItem>
        </Menu>

        <!-- Barra de estado -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Modo seguro · La aplicación productiva requiere preparación y confirmación"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Versión 0.4"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Contenido principal -->
        <Grid Margin="16">

            <Grid.RowDefinitions>
                <!-- Encabezado -->
                <RowDefinition Height="Auto"/>

                <!-- Selección de biblioteca -->
                <RowDefinition Height="Auto"/>

                <!-- Área principal de trabajo -->
                <RowDefinition Height="*"
                               MinHeight="320"/>

                <!-- Botones -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,8">

                <TextBlock Text="Audio Metadata Manager"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Organización, análisis y restauración segura de bibliotecas musicales"
                           Margin="0,2,0,0"
                           Foreground="DimGray"/>
            </StackPanel>

            <!-- Selección de carpeta y análisis -->
            <GroupBox Grid.Row="1"
            Header="Biblioteca musical"
            Padding="12"
            Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Text="Carpeta:"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

                    <TextBox Grid.Row="0"
                    Grid.Column="1"
                    x:Name="LibraryPathTextBox"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"
                    Margin="0,0,10,0"/>

                    <Button Grid.Row="0"
                    Grid.Column="2"
                    x:Name="BrowseButton"
                    Content="Examinar..."
                    MinWidth="110"
                    Padding="12,6"
                    Margin="0,0,10,0"
                    Click="BrowseButton_Click"/>

                    <Button Grid.Row="0"
                    Grid.Column="3"
                    x:Name="ScanButton"
                    Content="Analizar biblioteca"
                    MinWidth="150"
                    Padding="12,6"
                    IsEnabled="False"
                    Click="ScanButton_Click"/>

                        <!-- Acciones sobre el archivo seleccionado -->
                        <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                        <Button x:Name="AnalyzeSelectedFileButton"
                        Content="Analizar archivo"
                        MinWidth="145"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="AnalyzeSelectedFileButton_Click"/>

                        <Button x:Name="RunAudioDiagnosticButton"
                        Content="Diagnóstico técnico"
                        MinWidth="155"
                        Padding="12,6"
                        IsEnabled="False"
                        Click="RunAudioDiagnosticButton_Click"/>

                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Navegación principal -->
            <TabControl Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="4">

                <TabItem Header="Biblioteca">

                    <GroupBox Header="Archivos encontrados"
                              Padding="8"
                              Margin="6">

                        <DataGrid x:Name="AudioFilesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="AudioFilesDataGrid_SelectionChanged"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn Header="Aplicar"
                                                        Width="65"/>

                                <DataGridTextColumn Header="Archivo"
                                                    Binding="{Binding FileName}"
                                                    Width="SizeToCells"
                                                    MinWidth="240"/>

                                <DataGridTextColumn Header="Artista"
                                                    Binding="{Binding ParsedArtistDisplay}"
                                                    Width="SizeToCells"
                                                    MinWidth="170"/>

                                <DataGridTextColumn Header="Título"
                                                    Binding="{Binding ParsedTitleDisplay}"
                                                    Width="SizeToCells"
                                                    MinWidth="220"/>

                                <DataGridTextColumn Header="Versión"
                                                    Binding="{Binding ParsedVersionDisplay}"
                                                    Width="SizeToCells"
                                                    MinWidth="160"/>

                                <DataGridTextColumn Header="Confianza"
                                                    Binding="{Binding ConfidenceScoreDisplay}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Calidad"
                                                    Binding="{Binding QualityScoreDisplay}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="Estado"
                                                    Binding="{Binding Status}"
                                                    Width="110"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </GroupBox>

                </TabItem>

                <TabItem Header="Información">

                    <views:AudioFileDetailsView
                        DataContext="{Binding ElementName=AudioFilesDataGrid,
                                              Path=SelectedItem}"
                        Margin="6"/>

                </TabItem>

                <TabItem Header="Metadatos">

                    <controls:SimulationPlanView
                        x:Name="SimulationPlanViewControl"
                        Margin="6" />

                </TabItem>

                <TabItem Header="Renombrado">

                    <views:RenamePreviewView
                        DataContext="{Binding ElementName=AudioFilesDataGrid,
                                              Path=SelectedItem}"
                        Margin="6" />

                </TabItem>

                <TabItem Header="Duplicados"
                         IsEnabled="False">

                    <TextBlock Margin="20"
                               TextWrapping="Wrap"
                               Text="La detección segura de duplicados se incorporará en un próximo hito." />

                </TabItem>

                <TabItem Header="Actividad">

                    <GroupBox Header="Registro de actividad"
                              Padding="8"
                              Margin="6">

                        <TextBox x:Name="LogTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Text="Aplicación iniciada. Esperando selección de una biblioteca musical."/>

                    </GroupBox>

                </TabItem>

            </TabControl>

            <!-- Acciones inferiores -->
            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Estado y revisión del lote productivo -->
                <StackPanel Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <TextBlock x:Name="ProductiveBatchSummaryTextBlock"
                   Text="Lote productivo: ningún archivo seleccionado"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="0,0,12,0"/>

                    <Button x:Name="ReviewProductiveBatchButton"
                Content="Revisar lote"
                MinWidth="110"
                Padding="12,7"
                IsEnabled="False"
                Click="ReviewProductiveBatchButton_Click"/>

                </StackPanel>

                <!-- Acciones existentes -->
                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                    <Button x:Name="SaveProjectButton"
                Content="Guardar proyecto"
                MinWidth="130"
                Padding="12,7"
                Margin="0,0,10,0"
                IsEnabled="False"/>

                    <Button x:Name="ExportButton"
                Content="Exportar simulación"
                MinWidth="140"
                Padding="12,7"
                Margin="0,0,10,0"
                IsEnabled="False"/>

                    <Button x:Name="ApplyChangesButton"
                Content="Respaldar y aplicar cambios"
                MinWidth="190"
                Padding="12,7"
                IsEnabled="False"
                Click="ApplyChangesButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>
    </DockPanel>
</Window>
