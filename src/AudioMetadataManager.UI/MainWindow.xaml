<Window x:Class="AudioMetadataManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioMetadataManager.UI.Views"
        Title="Audio Metadata Manager"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nuevo proyecto"/>
                <MenuItem Header="Abrir proyecto"/>
                <Separator/>
                <MenuItem Header="Salir"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem Header="Configuración"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="Acerca de Audio Metadata Manager"/>
            </MenuItem>
        </Menu>

        <!-- Barra de estado -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Modo Simulación · Ningún archivo será modificado"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Versión 0.4"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Contenido principal -->
        <Grid Margin="16">

            <Grid.RowDefinitions>
                <!-- Encabezado -->
                <RowDefinition Height="Auto"/>

                <!-- Selección de biblioteca -->
                <RowDefinition Height="Auto"/>

                <!-- Tabla de archivos -->
                <RowDefinition Height="2*"
                               MinHeight="180"/>

                <!-- Panel de detalles -->
                <RowDefinition Height="2*"
                               MinHeight="230"/>

                <!-- Registro -->
                <RowDefinition Height="120"/>

                <!-- Botones -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">

                <TextBlock Text="Audio Metadata Manager"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Organización, análisis y restauración segura de bibliotecas musicales"
                           Margin="0,4,0,0"
                           Foreground="DimGray"/>
            </StackPanel>

            <!-- Selección de carpeta -->
            <GroupBox Grid.Row="1"
                      Header="Biblioteca musical"
                      Padding="12"
                      Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Carpeta:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="LibraryPathTextBox"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="2"
                            x:Name="BrowseButton"
                            Content="Examinar..."
                            MinWidth="110"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            Click="BrowseButton_Click"/>

                    <Button Grid.Column="3"
                            x:Name="ScanButton"
                            Content="Analizar biblioteca"
                            MinWidth="150"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="ScanButton_Click"/>
                </Grid>
            </GroupBox>

            <!-- Tabla principal resumida -->
            <GroupBox Grid.Row="2"
                      Header="Archivos encontrados"
                      Padding="8"
                      Margin="0,0,0,12"
                      MinHeight="180">

                <DataGrid x:Name="AudioFilesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MinHeight="140">

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="Aplicar"
                                                Width="65"/>

                        <DataGridTextColumn Header="Archivo"
                                            Binding="{Binding FileName}"
                                            Width="SizeToCells"
                                            MinWidth="240"/>

                        <DataGridTextColumn Header="Artista"
                                            Binding="{Binding ParsedArtistDisplay}"
                                            Width="SizeToCells"
                                            MinWidth="170"/>

                        <DataGridTextColumn Header="Título"
                                            Binding="{Binding ParsedTitleDisplay}"
                                            Width="SizeToCells"
                                            MinWidth="220"/>

                        <DataGridTextColumn Header="Versión"
                                            Binding="{Binding ParsedVersionDisplay}"
                                            Width="SizeToCells"
                                            MinWidth="160"/>

                        <DataGridTextColumn Header="Confianza"
                                            Binding="{Binding ConfidenceScoreDisplay}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Calidad"
                                            Binding="{Binding QualityScoreDisplay}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Estado"
                                            Binding="{Binding Status}"
                                            Width="110"/>

                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Panel de detalles -->
            <views:AudioFileDetailsView
                Grid.Row="3"
                DataContext="{Binding ElementName=AudioFilesDataGrid,
                                      Path=SelectedItem}"
                Margin="0,0,0,12"/>

            <!-- Registro de actividad -->
            <GroupBox Grid.Row="4"
                      Header="Registro de actividad"
                      Padding="8"
                      Margin="0,0,0,12">

                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="Aplicación iniciada. Esperando selección de una biblioteca musical."/>
            </GroupBox>

            <!-- Acciones inferiores -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="SaveProjectButton"
                        Content="Guardar proyecto"
                        MinWidth="130"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        IsEnabled="False"/>

                <Button x:Name="ExportButton"
                        Content="Exportar simulación"
                        MinWidth="140"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        IsEnabled="False"/>

                <Button x:Name="ApplyChangesButton"
                        Content="Respaldar y aplicar cambios"
                        MinWidth="190"
                        Padding="12,7"
                        IsEnabled="False"/>

            </StackPanel>

        </Grid>
    </DockPanel>
</Window>