<Window x:Class="AudioMetadataManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Metadata Manager"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nuevo proyecto"/>
                <MenuItem Header="Abrir proyecto"/>
                <Separator/>
                <MenuItem Header="Salir"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem Header="Configuración"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="Acerca de Audio Metadata Manager"/>
            </MenuItem>
        </Menu>

        <!-- Barra de estado -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Modo Simulación · Ningún archivo será modificado"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Versión 0.2"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">

                <TextBlock Text="Audio Metadata Manager"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Organización, análisis y restauración segura de bibliotecas musicales"
                           Margin="0,4,0,0"
                           Foreground="DimGray"/>
            </StackPanel>

            <!-- Selección de carpeta -->
            <GroupBox Grid.Row="1"
                      Header="Biblioteca musical"
                      Padding="12"
                      Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Carpeta:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="LibraryPathTextBox"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="2"
                            x:Name="BrowseButton"
                            Content="Examinar..."
                            MinWidth="110"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            Click="BrowseButton_Click"/>

                    <Button Grid.Column="3"
                            x:Name="ScanButton"
                            Content="Analizar biblioteca"
                            MinWidth="150"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="ScanButton_Click"/>
                </Grid>
            </GroupBox>

            <!-- Tabla principal -->
            <GroupBox Grid.Row="2"
                      Header="Archivos encontrados"
                      Padding="8"
                      Margin="0,0,0,12">

                <DataGrid x:Name="AudioFilesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="Aplicar"
                            Width="65"/>

                        <DataGridTextColumn Header="Archivo"
                        Binding="{Binding FileName}"
                        Width="SizeToCells"
                        MinWidth="220"/>

                        <DataGridTextColumn Header="Artista etiqueta"
                        Binding="{Binding Artist}"
                        Width="SizeToCells"
                        MinWidth="160"/>

                        <DataGridTextColumn Header="Artista nombre"
                        Binding="{Binding ParsedArtistDisplay}"
                        Width="SizeToCells"
                        MinWidth="160"/>

                        <DataGridTextColumn Header="Coincide artista"
                        Binding="{Binding ArtistMatchDisplay}"
                        Width="SizeToHeader"
                        MinWidth="105"/>

                        <DataGridTextColumn Header="Título etiqueta"
                        Binding="{Binding Title}"
                        Width="SizeToCells"
                        MinWidth="200"/>

                        <DataGridTextColumn Header="Título nombre"
                        Binding="{Binding ParsedTitleDisplay}"
                        Width="SizeToCells"
                        MinWidth="200"/>

                        <DataGridTextColumn Header="Versión"
                        Binding="{Binding ParsedVersionDisplay}"
                        Width="SizeToCells"
                        MinWidth="150"/>

                        <!-- Motor de confianza -->
                        <DataGridTextColumn Header="Confianza"
                        Binding="{Binding ConfidenceScoreDisplay}"
                        Width="SizeToHeader"
                        MinWidth="85"/>

                        <DataGridTextColumn Header="Nivel"
                        Binding="{Binding ConfidenceLevelDisplay}"
                        Width="SizeToCells"
                        MinWidth="90"/>

                        <DataGridTextColumn Header="Revisión"
                        Binding="{Binding ManualReviewDisplay}"
                        Width="SizeToHeader"
                        MinWidth="80"/>

                        <DataGridTextColumn Header="Resumen"
                        Binding="{Binding AnalysisSummaryDisplay}"
                        Width="SizeToCells"
                        MinWidth="320"/>

                        <!-- Motor de calidad musical -->
                        <DataGridTextColumn Header="Calidad"
                        Binding="{Binding QualityScoreDisplay}"
                        Width="SizeToHeader"
                        MinWidth="80"/>

                        <DataGridTextColumn Header="Nivel técnico"
                        Binding="{Binding QualityLevelDisplay}"
                        Width="SizeToCells"
                        MinWidth="155"/>

                        <DataGridTextColumn Header="Revisión técnica"
                        Binding="{Binding QualityReviewDisplay}"
                        Width="SizeToHeader"
                        MinWidth="115"/>

                        <DataGridTextColumn Header="Resumen técnico"
                        Binding="{Binding QualitySummaryDisplay}"
                        Width="SizeToCells"
                        MinWidth="360"/>

                        <DataGridTextColumn Header="Coincide título"
                        Binding="{Binding TitleMatchDisplay}"
                        Width="SizeToHeader"
                        MinWidth="105"/>

                        <!-- Información técnica -->
                        <DataGridTextColumn Header="Formato"
                        Binding="{Binding Extension}"
                        Width="SizeToHeader"
                        MinWidth="75"/>

                        <DataGridTextColumn Header="Duración"
                        Binding="{Binding DurationDisplay}"
                        Width="SizeToHeader"
                        MinWidth="85"/>

                        <DataGridTextColumn Header="Bitrate"
                        Binding="{Binding BitrateDisplay}"
                        Width="SizeToCells"
                        MinWidth="90"/>

                        <DataGridTextColumn Header="Muestreo"
                        Binding="{Binding SampleRateDisplay}"
                        Width="SizeToCells"
                        MinWidth="90"/>

                        <DataGridTextColumn Header="Canales"
                        Binding="{Binding Channels}"
                        Width="SizeToHeader"
                        MinWidth="70"/>

                        <DataGridTextColumn Header="Tamaño"
                        Binding="{Binding FileSizeDisplay}"
                        Width="SizeToCells"
                        MinWidth="90"/>

                        <DataGridTextColumn Header="Estado"
                        Binding="{Binding Status}"
                        Width="SizeToCells"
                        MinWidth="100"/>

                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Registro -->
            <GroupBox Grid.Row="3"
                      Header="Registro de actividad"
                      Padding="8"
                      Margin="0,0,0,12">

                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="Aplicación iniciada. Esperando selección de una biblioteca musical."/>
            </GroupBox>

            <!-- Acciones inferiores -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="SaveProjectButton"
                        Content="Guardar proyecto"
                        MinWidth="130"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        IsEnabled="False"/>

                <Button x:Name="ExportButton"
                        Content="Exportar simulación"
                        MinWidth="140"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        IsEnabled="False"/>

                <Button x:Name="ApplyChangesButton"
                        Content="Respaldar y aplicar cambios"
                        MinWidth="190"
                        Padding="12,7"
                        IsEnabled="False"/>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>