<UserControl x:Class="AudioMetadataManager.UI.Views.Controls.SimulationPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="8">

        <StackPanel>

            <!-- Encabezado -->
            <Border Padding="14"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Vista previa de simulación"
                                   FontSize="22"
                                   FontWeight="SemiBold" />

                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}" />

                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding FilePath}"
                                   Foreground="#666666"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}" />

                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="16,0,0,0"
                            Padding="14,8"
                            VerticalAlignment="Top"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            CornerRadius="14">

                        <TextBlock Text="{Binding StatusDisplay}"
                                   FontWeight="SemiBold" />

                    </Border>

                </Grid>

            </Border>

            <!-- Resumen -->
            <Border Margin="0,10,0,10"
                    Padding="12"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6">

                <TextBlock Text="{Binding Summary}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />

            </Border>

            <!-- Tabla -->
            <DataGrid x:Name="SimulationProposalsDataGrid"
                      ItemsSource="{Binding Proposals}"
                      Height="240"
                      MinHeight="200"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F7F7F7"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Aplicar"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Campo"
                                        Width="150"
                                        Binding="{Binding FieldDisplay}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Valor actual"
                                        Width="220"
                                        Binding="{Binding CurrentValue}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Valor propuesto"
                                        Width="220"
                                        Binding="{Binding ProposedValue}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Decisión"
                                        Width="210"
                                        Binding="{Binding DecisionDisplay}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Confianza"
                                        Width="95"
                                        Binding="{Binding ConfidenceDisplay}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Fuentes"
                                        Width="150"
                                        Binding="{Binding SourcesDisplay}"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="Estado de revisión"
                                        Width="180"
                                        Binding="{Binding ReviewState}"
                                        IsReadOnly="True" />

                </DataGrid.Columns>

            </DataGrid>

            <!-- Pie -->
            <Grid Margin="0,10,0,4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="#666666"
                           Text="Modo simulación: ningún archivo será modificado." />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="ValidateApprovedChangesButton"
                        Width="170"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Content="Validar cambios aprobados"
                        IsEnabled="{Binding HasApprovedChanges}"
                        Click="ValidateApprovedChangesButton_Click" />

                    <Button x:Name="SelectAutomaticButton"
                            Width="150"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Content="Seleccionar automáticos"
                            Click="SelectAutomaticButton_Click" />

                    <Button x:Name="ClearSelectionButton"
                            Width="130"
                            Padding="10,6"
                            Content="Limpiar selección"
                            Click="ClearSelectionButton_Click" />

                </StackPanel>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>