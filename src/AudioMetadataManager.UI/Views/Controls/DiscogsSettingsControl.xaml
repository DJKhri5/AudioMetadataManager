<UserControl x:Class="AudioMetadataManager.UI.Views.Controls.DiscogsSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">

    <Border
        Padding="20"
        BorderThickness="1"
        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
        CornerRadius="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="Discogs"
                        FontSize="19"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Margin="0,4,0,0"
                        Text="Fuente prioritaria para publicaciones, sellos, géneros, estilos y carátulas."
                        TextWrapping="Wrap"
                        Opacity="0.75" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Padding="12,6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    CornerRadius="12"
                    VerticalAlignment="Top">

                    <TextBlock
                        x:Name="DiscogsStatusTextBlock"
                        Text="Comprobando..."
                        FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Separator Grid.Row="2" />

            <TextBlock
                Grid.Row="4"
                Text="Introduce un token personal de Discogs. El token no se mostrará nuevamente después de guardarlo y nunca se añadirá al repositorio del proyecto."
                TextWrapping="Wrap" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,14,0"
                    Text="Token de usuario:"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />

                <PasswordBox
                    x:Name="DiscogsTokenPasswordBox"
                    Grid.Column="1"
                    MinHeight="32"
                    Padding="8,5"
                    PasswordChanged="DiscogsTokenPasswordBox_PasswordChanged" />
            </Grid>

            <WrapPanel
                Grid.Row="8"
                HorizontalAlignment="Left">

                <Button
                    x:Name="SaveDiscogsTokenButton"
                    MinWidth="130"
                    Height="34"
                    Margin="0,0,10,10"
                    Content="Guardar token"
                    IsEnabled="False"
                    Click="SaveDiscogsTokenButton_Click" />

                <Button
                    x:Name="DeleteDiscogsTokenButton"
                    MinWidth="130"
                    Height="34"
                    Margin="0,0,10,10"
                    Content="Eliminar token"
                    Click="DeleteDiscogsTokenButton_Click" />

                <Button
                    x:Name="TestDiscogsConnectionButton"
                    MinWidth="140"
                    Height="34"
                    Margin="0,0,0,10"
                    Content="Probar conexión"
                    IsEnabled="False"
                    Click="TestDiscogsConnectionButton_Click" />
            </WrapPanel>

            <Border
                Grid.Row="10"
                MinHeight="58"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                CornerRadius="4">

                <TextBlock
                    x:Name="DiscogsMessageTextBlock"
                    Text="Estado de configuración pendiente."
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>