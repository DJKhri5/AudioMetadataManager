<UserControl x:Class="AudioMetadataManager.UI.Views.RenamePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="300">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14">

        <StackPanel>

            <Border Padding="14"
                    Background="#F3F7FB"
                    BorderBrush="#B8C9D9"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>
                    <TextBlock Text="Renombrado Reversible de Archivos"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,6,0,0"
                               Foreground="#4F5F6F"
                               TextWrapping="Wrap"
                               Text="Saneamiento automático de caracteres Windows, prevención estricta de colisiones y bitácora transaccional con reversión." />
                </StackPanel>

            </Border>

            <GroupBox Header="Archivo seleccionado"
                      Margin="0,12,0,0"
                      Padding="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Nombre actual:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding FileName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FileName, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Text="Nombre propuesto:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ProposedFileNameDisplay, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ProposedFileNameDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2"
                               Text="Nombre saneado (Windows):"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding SanitizedProposedFileName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SanitizedProposedFileName, Mode=OneWay}"
                               Foreground="#0D47A1"
                               FontWeight="Medium"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3"
                               Text="Resultado:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding RenameStatusDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4"
                               Text="Confianza:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding RenameConfidenceDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5"
                               Text="Resumen:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="{Binding RenameSummaryDisplay, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <!-- Acciones de renombrado -->
                    <StackPanel Grid.Row="6"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,6,0,0">

                        <Button x:Name="RenameSingleFileButton"
                                Content="Renombrar archivo físico"
                                Padding="16,8"
                                FontWeight="SemiBold"
                                Background="#1976D2"
                                Foreground="White"
                                IsEnabled="{Binding CanRenameSafely, Mode=OneWay}"
                                Click="RenameSingleFileButton_Click" />

                    </StackPanel>

                </Grid>

            </GroupBox>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="#E8F5E9"
                    BorderBrush="#81C784"
                    BorderThickness="1"
                    CornerRadius="4">

                <TextBlock TextWrapping="Wrap"
                           Foreground="#1B5E20"
                           Text="Seguridad de renombrado activa: Se validan colisiones en disco antes de mover el archivo y se registra una bitácora con hash SHA-256 para permitir reversión en caso de discrepancias." />

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
