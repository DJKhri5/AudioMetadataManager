<UserControl x:Class="AudioMetadataManager.UI.Views.RenamePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="260">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14">

        <StackPanel>

            <Border Padding="14"
                    Background="#F3F7FB"
                    BorderBrush="#B8C9D9"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>
                    <TextBlock Text="Renombrado de archivos"
                               FontSize="22"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,6,0,0"
                               Foreground="#4F5F6F"
                               TextWrapping="Wrap"
                               Text="Vista previa independiente de los cambios de metadatos internos." />
                </StackPanel>

            </Border>

            <GroupBox Header="Archivo seleccionado"
                      Margin="0,12,0,0"
                      Padding="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Nombre actual:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding FileName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FileName, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Text="Nombre propuesto:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ProposedFileNameDisplay, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ProposedFileNameDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2"
                               Text="Resultado:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding RenameStatusDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3"
                               Text="Confianza:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding RenameConfidenceDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4"
                               Text="Revisión:"
                               FontWeight="SemiBold"
                               Margin="0,0,16,10" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding RenameReviewDisplay, Mode=OneWay}"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5"
                               Text="Resumen:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,0,16,0" />

                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="{Binding RenameSummaryDisplay, Mode=OneWay}"
                               TextWrapping="Wrap" />

                </Grid>

            </GroupBox>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="#FFF8E1"
                    BorderBrush="#D6B95F"
                    BorderThickness="1"
                    CornerRadius="4">

                <TextBlock TextWrapping="Wrap"
                           Foreground="#5F4A00"
                           Text="Solo vista previa: esta sección todavía no renombra archivos. La aplicación productiva se habilitará cuando incluya validación de nombres, detección de colisiones, respaldo y confirmación independiente." />

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
