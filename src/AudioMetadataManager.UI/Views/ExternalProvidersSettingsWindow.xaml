<Window x:Class="AudioMetadataManager.UI.Views.ExternalProvidersSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Proveedores de Metadatos Online"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🌐 Proveedores Externos de Metadatos" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Configura las credenciales de acceso y valida la conectividad con las plataformas soportadas." 
                       FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Providers List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- MusicBrainz -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MusicBrainz" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                <Border Background="#DEF7EC" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="API Pública (Sin clave)" FontSize="10" FontWeight="SemiBold" Foreground="#03543F"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Base de datos abierta comunitaria para artistas, títulos oficiales, sellos discográficos e ISRCs." 
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MusicBrainzStatusTextBlock" Text="Estado: Listo para consultas." FontSize="11" Foreground="#059669" FontWeight="Medium"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="TestMusicBrainzButton" Content="Probar conexión" Width="120" Height="30" 
                                VerticalAlignment="Center" Click="TestMusicBrainzButton_Click" Background="#F1F5F9"/>
                    </Grid>
                </Border>

                <!-- Discogs -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Discogs" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                    <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Personal Token" FontSize="10" FontWeight="SemiBold" Foreground="#3730A3"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Catálogo mundial de lanzamientos físicos y digitales, vinilos, sellos y ediciones especiales." 
                                           FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="TestDiscogsButton" Content="Probar conexión" Width="120" Height="30" 
                                    VerticalAlignment="Center" Click="TestDiscogsButton_Click" Background="#F1F5F9"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0" x:Name="DiscogsTokenPasswordBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" x:Name="SaveDiscogsButton" Content="Guardar" Width="75" Height="28" Margin="0,0,6,0" Click="SaveDiscogsButton_Click"/>
                                <Button Grid.Column="2" x:Name="DeleteDiscogsButton" Content="Borrar" Width="65" Height="28" Click="DeleteDiscogsButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="DiscogsStatusTextBlock" Text="Estado: No configurado." FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Beatport -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Beatport" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                    <Border Background="#FEF08A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Electrónica / Club" FontSize="10" FontWeight="SemiBold" Foreground="#854D0E"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Especializado en música electrónica, mezclas extendidas (Extended Mix), remixers y sellos de club." 
                                           FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="TestBeatportButton" Content="Probar conexión" Width="120" Height="30" 
                                    VerticalAlignment="Center" Click="TestBeatportButton_Click" Background="#F1F5F9"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="BeatportApiKeyTextBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" x:Name="SaveBeatportButton" Content="Guardar" Width="75" Height="28" Margin="0,0,6,0" Click="SaveBeatportButton_Click"/>
                                <Button Grid.Column="2" x:Name="DeleteBeatportButton" Content="Borrar" Width="65" Height="28" Click="DeleteBeatportButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="BeatportStatusTextBlock" Text="Estado: Búsqueda activa (API Key opcional)." FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Spotify -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Spotify" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Catálogo Streaming" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Catálogo general para verificación de artistas principales y colaboraciones." 
                                           FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="TestSpotifyButton" Content="Probar conexión" Width="120" Height="30" 
                                    VerticalAlignment="Center" Click="TestSpotifyButton_Click" Background="#F1F5F9"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="SpotifyApiKeyTextBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" x:Name="SaveSpotifyButton" Content="Guardar" Width="75" Height="28" Margin="0,0,6,0" Click="SaveSpotifyButton_Click"/>
                                <Button Grid.Column="2" x:Name="DeleteSpotifyButton" Content="Borrar" Width="65" Height="28" Click="DeleteSpotifyButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="SpotifyStatusTextBlock" Text="Estado: Búsqueda activa." FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SoundCloud -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SoundCloud" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                    <Border Background="#FFEDD5" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Remixes / Bootlegs" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Especializado en bootlegs, remixes y ediciones no oficiales (con aprobación manual de seguridad)." 
                                           FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="TestSoundCloudButton" Content="Probar conexión" Width="120" Height="30" 
                                    VerticalAlignment="Center" Click="TestSoundCloudButton_Click" Background="#F1F5F9"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="SoundCloudApiKeyTextBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" x:Name="SaveSoundCloudButton" Content="Guardar" Width="75" Height="28" Margin="0,0,6,0" Click="SaveSoundCloudButton_Click"/>
                                <Button Grid.Column="2" x:Name="DeleteSoundCloudButton" Content="Borrar" Width="65" Height="28" Click="DeleteSoundCloudButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="SoundCloudStatusTextBlock" Text="Estado: Búsqueda activa (Token opcional)." FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="TestAllButton" Content="⚡ Probar todas las conexiones" Height="32" Padding="14,0" Click="TestAllButton_Click" Background="#EEF2F6"/>
            <Button Grid.Column="2" Content="Cerrar" Height="32" Width="90" Click="CloseButton_Click" Background="#E2E8F0"/>
        </Grid>
    </Grid>
</Window>
