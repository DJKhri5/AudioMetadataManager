<Window x:Class="AudioMetadataManager.UI.Views.MetadataSourcesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioMetadataManager.UI.Views.Controls"
        Title="Fuentes de metadatos"
        Width="760"
        Height="600"
        MinWidth="660"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Text="Fuentes de metadatos"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBlock
                Margin="0,6,0,0"
                Text="Configura las plataformas utilizadas para buscar información musical. Las credenciales se almacenan localmente mediante Windows."
                TextWrapping="Wrap"
                Opacity="0.75" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <controls:DiscogsSettingsControl />
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="4"
            Width="100"
            Height="34"
            HorizontalAlignment="Right"
            Content="Cerrar"
            IsCancel="True"
            Click="CloseButton_Click" />
    </Grid>
</Window>