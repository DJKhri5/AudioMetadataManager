<UserControl x:Class="AudioMetadataManager.UI.Views.AudioFileDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="190">

    <Border BorderBrush="#D5D9DE"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Detalles del archivo seleccionado"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Archivo:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,20,6"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Estado:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="{Binding Status}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Artista etiqueta:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Artist}"
                           Margin="0,0,20,6"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Artista nombre:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="{Binding ParsedArtistDisplay}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Título etiqueta:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Title}"
                           Margin="0,0,20,6"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Título nombre:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="{Binding ParsedTitleDisplay}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Versión:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding ParsedVersionDisplay}"
                           Margin="0,0,20,6"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="Formato:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,6"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="3"
                           Text="{Binding Extension}"
                           Margin="0,0,0,6"/>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,12,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="Confianza del análisis"
                          Padding="8">

                    <StackPanel>
                        <TextBlock>
                            <Run Text="Puntuación: " FontWeight="SemiBold"/>
                            <Run Text="{Binding ConfidenceScoreDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Nivel: " FontWeight="SemiBold"/>
                            <Run Text="{Binding ConfidenceLevelDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0"
                            Text="{Binding AnalysisSummaryDisplay, Mode=OneWay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2"
                          Header="Calidad técnica"
                          Padding="8">

                    <StackPanel>
                        <TextBlock>
                            <Run Text="Puntuación: " FontWeight="SemiBold"/>
                            <Run Text="{Binding QualityScoreDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Nivel: " FontWeight="SemiBold"/>
                            <Run Text="{Binding QualityLevelDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0"
                            Text="{Binding QualitySummaryDisplay, Mode=OneWay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>